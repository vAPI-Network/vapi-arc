# Arc Testnet JSON-RPC endpoint.
ARC_RPC_URL=https://rpc.testnet.arc.network
# ERC-8183 AgenticCommerce proxy; defaults to the address pinned in its ABI artifact.
AGENTIC_COMMERCE=0x0747EEf0706327138c69792bF28Cd525089e4583
# Arc Testnet USDC used by AgenticCommerce and reviewer payouts.
ARC_USDC=0x3600000000000000000000000000000000000000
# Source-verified EvaluationRouter v3 deployment.
ROUTER_ADDRESS=0x44A51C365eB3eC703534ebb56394E7015930533D
# Oracle EOA private key used only for live router submissions; never needed by dry-run.
ORACLE_PK=
# Anthropic API key used only for live judging; never needed by dry-run.
ANTHROPIC_API_KEY=
# Anthropic judge model.
JUDGE_MODEL=claude-sonnet-5
# Local judge health port. Railway injects PORT, which takes precedence.
JUDGE_PORT=8790
# A completed Arc poll stays ready for five minutes, allowing model evaluation,
# evidence publication, and transaction confirmation within one polling pass.
JUDGE_HEALTH_MAX_STALENESS_MS=300000
# Maximum automatically settled job budget in 6-decimal USDC units (100 USDC).
AUTO_SETTLE_CAP=100000000
# Minimum AI confidence in basis points.
MIN_CONFIDENCE_BP=8000

# --- Paid Human Review Exchange ---
# Set to a persistent Railway volume mount for judge cursor/deliverables/evidence.
VAPI_DATA_ROOT=
# Circle Gateway receives the x402 review fee for this seller.
X402_SELLER_ADDRESS=
X402_NETWORK=eip155:5042002
X402_FACILITATOR_URL=https://gateway-api-testnet.circle.com
# Six-decimal USDC integer units: $0.25 fee and $0.20 reviewer reward.
REVIEW_PRICE_USDC=250000
REVIEWER_REWARD_USDC=200000
REVIEW_PORT=8787
REVIEW_PUBLIC_BASE_URL=http://localhost:8787
REVIEW_DATABASE_PATH=./data/review-exchange.sqlite
REVIEW_INTERNAL_TOKEN=
# Judge-to-review-service endpoint used to persist evidence before every AI decision.
REVIEW_SERVICE_INTERNAL_URL=http://localhost:8787
# Optional declarative fresh-volume council seed. The value is a JSON array;
# startup validates and idempotently upserts by telegramUserId before health.
REVIEW_BOOTSTRAP_REVIEWERS_JSON=
REVIEW_CLAIM_TTL_SECONDS=600
REVIEW_SLA_SECONDS=1800
# Defaults to review SLA + two Circle polling windows + 60 seconds.
REVIEW_MIN_JOB_EXPIRY_SECONDS=2220
REVIEW_MAX_DISPATCHES=2
REVIEW_BACKGROUND_INTERVAL_MS=5000
REVIEW_LOG_LOOKBACK_BLOCKS=100000
# Keep false outside intentionally incomplete local discovery/test runs.
REVIEW_ALLOW_PARTIAL_CONFIG=false

# --- Two-click Live Trust Demo ---
# Keeps both signer keys inside vapi-review; the browser and dashboard service
# receive only sanitized run state through the internal bearer API.
DEMO_ENABLED=false
DEMO_CLIENT_PK=
DEMO_PROVIDER_PK=
# Six-decimal USDC units ($1), 24-hour escrow, at most three starts per hour.
DEMO_ESCROW_BUDGET_USDC=1000000
DEMO_JOB_TTL_SECONDS=86400
DEMO_MAX_RUNS_PER_HOUR=3
# Railway private-network judge health URL, for example
# http://vapi-judge.railway.internal:8790/health
DEMO_JUDGE_HEALTH_URL=

# Telegram Bot API webhook delivery and allowlisted reviewer dispatch.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Circle Developer-Controlled Wallet treasury and authorized v3 resolver.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_ID=
CIRCLE_WALLET_ADDRESS=
# Minimum treasury balance in 6-decimal USDC units; defaults to fee + reward.
REVIEW_MIN_TREASURY_USDC=450000
# Maximum wait for one asynchronous Circle transaction.
CIRCLE_TRANSACTION_TIMEOUT_MS=180000
# A terminal FAILED/DENIED/CANCELLED Circle transaction gets a fresh
# idempotency key up to this limit. STUCK remains in-flight and is never rotated.
CIRCLE_MAX_ATTEMPTS=3

# Dashboard-to-review-service connection.
REVIEW_SERVICE_URL=http://localhost:8787
# Presenter-only web session. Keep the access code out of logs and use at
# least 32 random bytes for the signed HttpOnly session secret.
DEMO_ACCESS_CODE=
DEMO_SESSION_SECRET=
